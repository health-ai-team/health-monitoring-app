generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(PATIENT)
  name         String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  healthEntries HealthEntry[] @relation("PatientHealthEntries")

  @@map("users")
}

model HealthEntry {
  id String @id @default(uuid())

  patientId String @map("patient_id")

  sleepHours Float?  @map("sleep_hours")
  weight     Float?
  mood       Int?
  symptoms   Json?
  notes      String?

  recordedAt DateTime @default(now()) @map("recorded_at")
  createdAt  DateTime @default(now()) @map("created_at")

  patient User @relation("PatientHealthEntries", fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("health_entries")
}
